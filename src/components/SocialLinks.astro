---
import { Icon } from 'astro-icon/components';
import { tv, type VariantProps } from 'tailwind-variants';
import Link from './Link.astro';

const social = tv({
  slots: {
    list: 'm-0 flex list-none flex-wrap items-center p-0',
    link: 'flex items-center text-body',
  },
  variants: {
    layout: {
      /** Header: icon-only, 44px targets, header socials only. */
      icons: { list: 'gap-0.5', link: 'size-11 justify-center text-strong' },
      /** "Find me on": one row per social (icon, name, handle, arrow), all socials. */
      labelled: {
        list: 'max-w-md flex-col items-stretch border-t border-line text-lg sm:text-xl',
        link: 'min-h-14 gap-3 border-b border-line py-2 hover:text-strong',
      },
    },
  },
  defaultVariants: { layout: 'labelled' },
});

interface Props extends VariantProps<typeof social> {
  socials: { name: string; url: string; icon: string; handle?: string; inHeader: boolean }[];
}

const { socials, layout = 'labelled' } = Astro.props;
const s = social({ layout });
const shown = layout === 'icons' ? socials.filter((x) => x.inHeader) : socials;
---

<ul class={s.list()}>
  {shown.map((x) => (
    <li>
      <Link
        href={x.url}
        variant="bare"
        class={s.link()}
        aria-label={layout === 'icons' ? `${x.name} (opens in a new tab)` : undefined}
      >
        <Icon
          name={x.icon}
          size={layout === 'icons' ? 22 : 21}
          class="shrink-0"
          aria-hidden="true"
        />
        {layout === 'labelled' && (
          <>
            <span class="text-strong">{x.name}</span>
            {x.handle && (
              <span class="ml-auto min-w-0 truncate text-base text-muted sm:text-lg">
                {x.handle}
              </span>
            )}
            <Icon
              name="lucide:arrow-up-right"
              size={18}
              class={`shrink-0 text-muted ${x.handle ? '' : 'ml-auto'}`}
              aria-hidden="true"
            />
          </>
        )}
      </Link>
    </li>
  ))}
</ul>
