---
import { url } from '../lib/url';

interface Props {
  title: string;
  description: string;
  /** Site name shown by link previews. */
  siteName: string;
  /** Path under public/, e.g. `/og.png`. */
  image?: string;
  /** Keep the page out of search results (e.g. 404). */
  noindex?: boolean;
}

const { title, description, siteName, image = '/og.png', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(url(image), Astro.site);
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}

<link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
<link rel="icon" href={url('/favicon-32.png')} type="image/png" sizes="32x32" />
<link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
<link rel="sitemap" href={url('/sitemap-index.xml')} />

<!-- Link previews (LinkedIn, Slack, X, WhatsApp…) -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`Preview card for ${siteName}’s portfolio`} />
<meta name="twitter:card" content="summary_large_image" />
