---
import { Icon } from 'astro-icon/components';
import { nav } from '../lib/site';
import { routeOf } from '../lib/url';
import Cursor from './Cursor.astro';
import Link from './Link.astro';
import SocialLinks from './SocialLinks.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  logoText: string;
  name: string;
  socials: { name: string; url: string; icon: string; inHeader: boolean }[];
}
const { logoText, name, socials } = Astro.props;

const current = routeOf(Astro.url.pathname);
const headerSocials = socials.filter((s) => s.inHeader);
// One cursor per screen: after the selected desktop tab, or after the logo where no tab is selected.
// The drawer marks the current page by colour only, without a cursor.
const onNavPage = nav.some((item) => item.href === current);
---

<!--
  Desktop (md+): logo · nav · icons in one row.
  Phones/tablets: logo + a menu button that opens a drawer with the nav, socials and theme toggle.
-->
<script is:inline>
  // Type the logo once per browser session. Runs before the header paints; without JS the logo just shows.
  try {
    if (!sessionStorage.getItem('typed')) {
      document.documentElement.dataset.typing = '';
      sessionStorage.setItem('typed', '1');
    }
  } catch {}
</script>

<header class="flex items-center justify-between gap-8 border-b border-line px-5 py-4 sm:px-10 md:border-b-0 md:py-6">
  <Link
    href="/"
    variant="bare"
    aria-label={`${name}, home`}
    class="font-mono text-[22px] font-bold text-strong md:text-[26px]"
    style={`--chars: ${logoText.length + 1}`}
  >
    <span data-prompt class="inline-block whitespace-nowrap">
      <span class="text-accent">~</span>
      {logoText}
    </span>
    {!onNavPage && <Cursor />}
  </Link>

  <div class="hidden items-center gap-8 md:flex">
    <nav aria-label="Main" class="flex items-center gap-x-8">
      {nav.map((item) => (
        <Link
          href={item.href}
          variant="bare"
          aria-current={current === item.href ? 'page' : undefined}
          class:list={[
            'flex min-h-11 items-center font-mono text-[15px] font-semibold',
            current === item.href ? 'text-accent-ink' : 'text-strong',
          ]}
        >
          <span class="relative">
            {item.label}
            {current === item.href && <Cursor placement="after" />}
          </span>
        </Link>
      ))}
    </nav>
    <div class="-mr-3 flex items-center gap-0.5">
      <SocialLinks socials={socials} layout="icons" />
      <ThemeToggle />
    </div>
  </div>

  <button
    type="button"
    data-drawer-open
    aria-label="Open menu"
    aria-haspopup="dialog"
    aria-controls="site-drawer"
    class="-mr-3 flex size-11 cursor-pointer items-center justify-center border-0 bg-transparent p-0 text-strong transition-colors hover:text-accent-ink md:hidden"
  >
    <Icon name="lucide:menu" size={22} aria-hidden="true" />
  </button>
</header>

<dialog
  id="site-drawer"
  aria-label="Menu"
  class="fixed inset-y-0 right-0 left-auto m-0 h-dvh max-h-none w-[min(320px,85vw)] max-w-none translate-x-full border-0 border-l border-line bg-page p-0 text-strong transition-[translate,display,overlay] transition-discrete duration-200 ease-out open:translate-x-0 starting:open:translate-x-full motion-reduce:transition-none backdrop:bg-page/70 backdrop:opacity-0 backdrop:backdrop-blur-sm backdrop:transition-[opacity,display,overlay] backdrop:transition-discrete backdrop:duration-200 open:backdrop:opacity-100 starting:open:backdrop:opacity-0 motion-reduce:backdrop:transition-none md:hidden"
>
  <div class="flex h-full flex-col px-6 py-4">
    <div class="flex items-center justify-between">
      <span class="text-sm font-semibold text-muted">Menu</span>
      <form method="dialog">
        <button
          type="submit"
          aria-label="Close menu"
          class="-mr-3 flex size-11 cursor-pointer items-center justify-center border-0 bg-transparent p-0 text-strong transition-colors hover:text-accent-ink"
        >
          <Icon name="lucide:x" size={24} aria-hidden="true" />
        </button>
      </form>
    </div>

    <nav aria-label="Main" class="mt-6 flex flex-col border-b border-line pb-6">
      {nav.map((item) => (
        <Link
          href={item.href}
          variant="bare"
          aria-current={current === item.href ? 'page' : undefined}
          class:list={[
            'flex min-h-12 items-center font-mono text-[17px] font-semibold',
            current === item.href ? 'text-accent-ink' : 'text-strong',
          ]}
        >
          {item.label}
        </Link>
      ))}
    </nav>

    <div class="mt-6">
      <SocialLinks socials={headerSocials} layout="labelled" />
    </div>

    <div class="mt-auto flex items-center justify-between border-t border-line pt-4">
      <span class="text-base text-body">Theme</span>
      <ThemeToggle />
    </div>
  </div>
</dialog>

<script>
  const drawer = document.getElementById('site-drawer') as HTMLDialogElement | null;
  const opener = document.querySelector<HTMLButtonElement>('[data-drawer-open]');
  if (drawer && opener) {
    opener.addEventListener('click', () => drawer.showModal());
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    drawer.addEventListener('click', (e) => {
      // Close on backdrop click (outside the panel).
      if (e.target === drawer) return drawer.close();
      // A same-tab link: let the drawer slide out first, then navigate.
      const link = (e.target as Element).closest('a');
      if (!link || link.target === '_blank' || reducedMotion.matches) return;
      if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      drawer.close();
      let gone = false;
      const go = () => {
        if (gone) return;
        gone = true;
        location.assign(link.href);
      };
      drawer.addEventListener('transitionend', go, { once: true });
      setTimeout(go, 300); // in case no transition runs
    });
    // Close if the viewport grows to desktop while open.
    matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
      if (e.matches && drawer.open) drawer.close();
    });
  }
</script>
